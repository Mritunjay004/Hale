{
  "expo": {
    "name": "Hale",
    "slug": "hale-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBFBF9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hale.assistant",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Hale uses your microphone to transcribe meal logs in seconds.",
        "NSCameraUsageDescription": "Hale uses your camera to identify food and parse blood report biomarkers."
      }
    },
    "android": {
      "package": "com.hale.assistant",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBFBF9"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "hale",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c3e23631-1b99-48cd-8a04-189d2309c9ce"
      }
    }
  }
}
