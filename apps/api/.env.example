# Hale API Environment Variables
# Copy to .env and fill in real values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hale_dev

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081

# AI Providers (set AI_PROVIDER=fake for local dev without keys)
AI_PROVIDER=fake
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here

# Demo mode
DEMO_MODE_ENABLED=true
